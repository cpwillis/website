{
  "name": "website",
  "compatibility_date": "2026-03-24",
  // declared here rather than only in the dashboard, so a redeploy from a clean checkout keeps the domain
  "routes": [
    {
      "pattern": "cpwillis.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // assets only, no worker code: home and icons redirect via public/_redirects
  "assets": {
    "directory": "./public",
    // a mistyped url was a zero-byte body with no content-type
    "not_found_handling": "404-page"
  }
}
